# GitHub is the source of issues and repository contents.
GITHUB_REPOSITORY=owner/repository
# Event source: webhook (default) or poll. Poll needs no webhook listener/secret or Cloudflare relay.
GITHUB_EVENT_SOURCE=webhook
# Poll interval: 15000–3600000 ms; default 60000 (only used when GITHUB_EVENT_SOURCE=poll).
GITHUB_POLL_INTERVAL_MS=60000
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Recommended: GitHub App authentication with automatic token renewal.
# GITHUB_APP_CLIENT_ID=your-app-client-id
# GITHUB_APP_PRIVATE_KEY_PATH=/absolute/private/path/issue-agent.pem
# Optional: discover the installation automatically when omitted.
# GITHUB_APP_INSTALLATION_ID=123456
# Alternative: static token with Contents read; add Issues read for poll mode,
# and Issues write when feedback is enabled.
# Complete App credentials take precedence over GITHUB_TOKEN.
GITHUB_TOKEN=
# Optional: use a local clone instead of downloading the repository from GitHub.
# REPOSITORY_PATH=/absolute/path/to/checkout
BASE_REF=HEAD

# Model adapter. Set the model ID available from your provider.
MODEL_PROVIDER=anthropic
MODEL=your-model-id
MODEL_API_KEY=
# For MODEL_PROVIDER=openai-compatible, set the full API base URL:
# MODEL_BASE_URL=https://your-provider.example/v1

DATA_DIR=./data
HOST=127.0.0.1
PORT=3000
CONCURRENCY=2
LEASE_MS=60000
MAX_ATTEMPTS=3
MAX_STEPS=40
RUN_TIMEOUT_MS=600000

# A durable event timeline is saved for each attempt, including failed attempts.
# Optional local terminal replay; view in the console's Runs page or download .cast.
ASCIINEMA_ENABLED=false
ASCIINEMA_COLS=100
ASCIINEMA_ROWS=28
ASCIINEMA_MAX_BYTES=10485760

# All new issues qualify by default; filters are optional.
# ISSUE_ACTIONS selects webhook actions only; poll mode discovers eligible open issues once.
ISSUE_ACTIONS=opened,reopened,labeled
# ISSUE_LABELS=agent,ready
# ISSUE_AUTHORS=your-login
# BOT_LOGINS=your-service-login
COMMENT_PREFIX=/agent
GITHUB_FEEDBACK=true
# EXTENSIONS=./examples/extensions.mjs

# GitHub Enterprise can override both endpoints:
# GITHUB_SERVER_URL=https://github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

# Optional Cloudflare Queue relay. Leave unset for direct webhooks.
# Deploy deploy/cloudflare first; see docs/cloudflare-relay.md.
# The local process pulls over HTTPS and commits to SQLite before acknowledging.
# CLOUDFLARE_RELAY_URL=https://github-issue-webhook-relay.YOUR-SUBDOMAIN.workers.dev
# CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
# CLOUDFLARE_QUEUE_ID=your-32-character-queue-id
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_RELAY_TOKEN=
# CLOUDFLARE_POLL_INTERVAL_MS=5000
